<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_RestaurantDineIn"
                  targetNamespace="http://amendia.example/processes/restaurant-dinein"
                  exporter="Amendia" exporterVersion="0.1">
  <bpmn:process id="Process_RestaurantDineIn"
                name="Restaurant Dine-In - Order &amp; Service"
                isExecutable="true">
    <bpmn:documentation>The domain-simple "hello world" for Amendia: a seated party orders; the order is
    validated and allergen-screened (revise loop on a problem); the kitchen fires the ticket under an SLA
    and prepares it; the party is served and pays (resolve loop on a decline). Same control spine as the
    wire-transfer reference, a friendlier domain. Execution metadata (bindings, HITL, SoD) lives in the
    Amendia annotation manifest (ADR-002), not in this file.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_DineIn">
      <bpmn:lane id="Lane_DigitalHost" name="Digital Host">
        <bpmn:flowNodeRef>Start_PartySeated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AllergenClear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateBill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ServedPaid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Diner" name="Diner">
        <bpmn:flowNodeRef>Task_SelectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentPayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Server">
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ServeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolvePayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_ScreenAllergens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FireTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_SLA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>Task_ServiceRecovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_PartySeated" name="Party seated">
      <bpmn:outgoing>Flow_Start_Menu</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_PresentMenu" name="Present menu">
      <bpmn:incoming>Flow_Start_Menu</bpmn:incoming>
      <bpmn:outgoing>Flow_Menu_Take</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_SelectItems" name="Select items">
      <bpmn:incoming>Flow_Menu_Take</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Take</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TakeOrder" name="Take order">
      <bpmn:incoming>Flow_Select_Take</bpmn:incoming>
      <bpmn:outgoing>Flow_Take_Validate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate order">
      <bpmn:incoming>Flow_Take_Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Revise_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OrderOK" name="Order valid?" default="Flow_OrderNeedsInfo">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderNeedsInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ReviseOrder" name="Revise order">
      <bpmn:incoming>Flow_OrderNeedsInfo</bpmn:incoming>
      <bpmn:incoming>Flow_AllergenConflict</bpmn:incoming>
      <bpmn:outgoing>Flow_Revise_Validate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ScreenAllergens" name="Allergen &amp; dietary screen">
      <bpmn:incoming>Flow_OrderOK</bpmn:incoming>
      <bpmn:outgoing>Flow_Screen_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_AllergenClear" name="Allergens clear?" default="Flow_AllergenConflict">
      <bpmn:incoming>Flow_Screen_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AllergenClear</bpmn:outgoing>
      <bpmn:outgoing>Flow_AllergenConflict</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_FireTicket" name="Fire ticket to kitchen">
      <bpmn:incoming>Flow_AllergenClear</bpmn:incoming>
      <bpmn:outgoing>Flow_Fire_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_PrepareReady" name="Prepare &amp; mark ready">
      <bpmn:incoming>Flow_Fire_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Serve</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_SLA" name="2 min SLA" attachedToRef="Task_PrepareReady" cancelActivity="true">
      <bpmn:outgoing>Flow_SLA_Recovery</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_ServiceRecovery" name="Service recovery">
      <bpmn:incoming>Flow_SLA_Recovery</bpmn:incoming>
      <bpmn:outgoing>Flow_Recovery_Serve</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ServeOrder" name="Serve order">
      <bpmn:incoming>Flow_Prepare_Serve</bpmn:incoming>
      <bpmn:incoming>Flow_Recovery_Serve</bpmn:incoming>
      <bpmn:outgoing>Flow_Serve_Bill</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_GenerateBill" name="Generate bill">
      <bpmn:incoming>Flow_Serve_Bill</bpmn:incoming>
      <bpmn:outgoing>Flow_Bill_Present</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_PresentPayment" name="Present payment">
      <bpmn:incoming>Flow_Bill_Present</bpmn:incoming>
      <bpmn:outgoing>Flow_Present_Pay</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ProcessPayment" name="Process payment">
      <bpmn:incoming>Flow_Present_Pay</bpmn:incoming>
      <bpmn:incoming>Flow_Resolve_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_PaymentOK" name="Payment captured?" default="Flow_PaymentDeclined">
      <bpmn:incoming>Flow_Pay_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentCaptured</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ResolvePayment" name="Resolve payment">
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_Pay</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_ServedPaid" name="Served &amp; paid">
      <bpmn:incoming>Flow_PaymentCaptured</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Menu" sourceRef="Start_PartySeated" targetRef="Task_PresentMenu"/>
    <bpmn:sequenceFlow id="Flow_Menu_Take" sourceRef="Task_PresentMenu" targetRef="Task_SelectItems"/>
    <bpmn:sequenceFlow id="Flow_Select_Take" sourceRef="Task_SelectItems" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="Flow_Take_Validate" sourceRef="Task_TakeOrder" targetRef="Task_ValidateOrder"/>
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateOrder" targetRef="Gateway_OrderOK"/>
    <bpmn:sequenceFlow id="Flow_OrderOK" name="ok" sourceRef="Gateway_OrderOK" targetRef="Task_ScreenAllergens">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        language="https://www.omg.org/spec/DMN/20191111/FEEL/">validation.order_verdict = "ok"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OrderNeedsInfo" name="needs info (default)" sourceRef="Gateway_OrderOK" targetRef="Task_ReviseOrder"/>
    <bpmn:sequenceFlow id="Flow_Revise_Validate" sourceRef="Task_ReviseOrder" targetRef="Task_ValidateOrder"/>
    <bpmn:sequenceFlow id="Flow_Screen_Gateway" sourceRef="Task_ScreenAllergens" targetRef="Gateway_AllergenClear"/>
    <bpmn:sequenceFlow id="Flow_AllergenClear" name="clear" sourceRef="Gateway_AllergenClear" targetRef="Task_FireTicket">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        language="https://www.omg.org/spec/DMN/20191111/FEEL/">allergen.allergen_status = "clear"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AllergenConflict" name="conflict (default)" sourceRef="Gateway_AllergenClear" targetRef="Task_ReviseOrder"/>
    <bpmn:sequenceFlow id="Flow_Fire_Prepare" sourceRef="Task_FireTicket" targetRef="Task_PrepareReady"/>
    <bpmn:sequenceFlow id="Flow_SLA_Recovery" sourceRef="Boundary_SLA" targetRef="Task_ServiceRecovery"/>
    <bpmn:sequenceFlow id="Flow_Prepare_Serve" sourceRef="Task_PrepareReady" targetRef="Task_ServeOrder"/>
    <bpmn:sequenceFlow id="Flow_Recovery_Serve" sourceRef="Task_ServiceRecovery" targetRef="Task_ServeOrder"/>
    <bpmn:sequenceFlow id="Flow_Serve_Bill" sourceRef="Task_ServeOrder" targetRef="Task_GenerateBill"/>
    <bpmn:sequenceFlow id="Flow_Bill_Present" sourceRef="Task_GenerateBill" targetRef="Task_PresentPayment"/>
    <bpmn:sequenceFlow id="Flow_Present_Pay" sourceRef="Task_PresentPayment" targetRef="Task_ProcessPayment"/>
    <bpmn:sequenceFlow id="Flow_Pay_Gateway" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentOK"/>
    <bpmn:sequenceFlow id="Flow_PaymentCaptured" name="captured" sourceRef="Gateway_PaymentOK" targetRef="End_ServedPaid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        language="https://www.omg.org/spec/DMN/20191111/FEEL/">receipt.payment_status = "captured"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentDeclined" name="declined (default)" sourceRef="Gateway_PaymentOK" targetRef="Task_ResolvePayment"/>
    <bpmn:sequenceFlow id="Flow_Resolve_Pay" sourceRef="Task_ResolvePayment" targetRef="Task_ProcessPayment"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_RestaurantDineIn">
    <bpmndi:BPMNPlane id="Plane_RestaurantDineIn" bpmnElement="Process_RestaurantDineIn">
      <bpmndi:BPMNShape id="S_Lane_DigitalHost" bpmnElement="Lane_DigitalHost" isHorizontal="true"><dc:Bounds x="160" y="80" width="2100" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Server" bpmnElement="Lane_Server" isHorizontal="true"><dc:Bounds x="160" y="280" width="2100" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Kitchen" bpmnElement="Lane_Kitchen" isHorizontal="true"><dc:Bounds x="160" y="480" width="2100" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Manager" bpmnElement="Lane_Manager" isHorizontal="true"><dc:Bounds x="160" y="680" width="2100" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Diner" bpmnElement="Lane_Diner" isHorizontal="true"><dc:Bounds x="160" y="880" width="2100" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start_PartySeated"><dc:Bounds x="220" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Menu" bpmnElement="Task_PresentMenu"><dc:Bounds x="300" y="140" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SelectItems" bpmnElement="Task_SelectItems"><dc:Bounds x="300" y="940" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Take" bpmnElement="Task_TakeOrder"><dc:Bounds x="470" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Validate" bpmnElement="Task_ValidateOrder"><dc:Bounds x="640" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GwOrder" bpmnElement="Gateway_OrderOK" isMarkerVisible="true"><dc:Bounds x="830" y="155" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Revise" bpmnElement="Task_ReviseOrder"><dc:Bounds x="830" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Screen" bpmnElement="Task_ScreenAllergens"><dc:Bounds x="920" y="540" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GwAllergen" bpmnElement="Gateway_AllergenClear" isMarkerVisible="true"><dc:Bounds x="1110" y="155" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Fire" bpmnElement="Task_FireTicket"><dc:Bounds x="1200" y="540" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Prepare" bpmnElement="Task_PrepareReady"><dc:Bounds x="1370" y="540" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SLA" bpmnElement="Boundary_SLA"><dc:Bounds x="1412" y="602" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Recovery" bpmnElement="Task_ServiceRecovery"><dc:Bounds x="1370" y="740" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Serve" bpmnElement="Task_ServeOrder"><dc:Bounds x="1540" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Bill" bpmnElement="Task_GenerateBill"><dc:Bounds x="1710" y="140" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_PresentPayment" bpmnElement="Task_PresentPayment"><dc:Bounds x="1770" y="940" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Pay" bpmnElement="Task_ProcessPayment"><dc:Bounds x="1880" y="740" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GwPay" bpmnElement="Gateway_PaymentOK" isMarkerVisible="true"><dc:Bounds x="2050" y="155" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Resolve" bpmnElement="Task_ResolvePayment"><dc:Bounds x="1880" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End" bpmnElement="End_ServedPaid"><dc:Bounds x="2170" y="162" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_Start_Menu" bpmnElement="Flow_Start_Menu"><di:waypoint x="256" y="180"/><di:waypoint x="300" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Menu_Take" bpmnElement="Flow_Menu_Take"><di:waypoint x="360" y="220"/><di:waypoint x="360" y="940"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Select_Take" bpmnElement="Flow_Select_Take"><di:waypoint x="420" y="980"/><di:waypoint x="445" y="980"/><di:waypoint x="445" y="380"/><di:waypoint x="470" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Take_Validate" bpmnElement="Flow_Take_Validate"><di:waypoint x="590" y="380"/><di:waypoint x="640" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Validate_Gw" bpmnElement="Flow_Validate_Gateway"><di:waypoint x="760" y="380"/><di:waypoint x="795" y="380"/><di:waypoint x="795" y="180"/><di:waypoint x="830" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_OrderOK" bpmnElement="Flow_OrderOK"><di:waypoint x="855" y="205"/><di:waypoint x="855" y="580"/><di:waypoint x="920" y="580"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_OrderNeedsInfo" bpmnElement="Flow_OrderNeedsInfo"><di:waypoint x="855" y="205"/><di:waypoint x="855" y="280"/><di:waypoint x="890" y="280"/><di:waypoint x="890" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Revise_Validate" bpmnElement="Flow_Revise_Validate"><di:waypoint x="830" y="380"/><di:waypoint x="760" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Screen_Gw" bpmnElement="Flow_Screen_Gateway"><di:waypoint x="1040" y="580"/><di:waypoint x="1075" y="580"/><di:waypoint x="1075" y="180"/><di:waypoint x="1110" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_AllergenClear" bpmnElement="Flow_AllergenClear"><di:waypoint x="1135" y="205"/><di:waypoint x="1135" y="580"/><di:waypoint x="1200" y="580"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_AllergenConflict" bpmnElement="Flow_AllergenConflict"><di:waypoint x="1135" y="205"/><di:waypoint x="1135" y="460"/><di:waypoint x="890" y="460"/><di:waypoint x="890" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Fire_Prepare" bpmnElement="Flow_Fire_Prepare"><di:waypoint x="1320" y="580"/><di:waypoint x="1370" y="580"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SLA_Recovery" bpmnElement="Flow_SLA_Recovery"><di:waypoint x="1430" y="638"/><di:waypoint x="1430" y="740"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Prepare_Serve" bpmnElement="Flow_Prepare_Serve"><di:waypoint x="1490" y="580"/><di:waypoint x="1515" y="580"/><di:waypoint x="1515" y="380"/><di:waypoint x="1540" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Recovery_Serve" bpmnElement="Flow_Recovery_Serve"><di:waypoint x="1490" y="780"/><di:waypoint x="1600" y="780"/><di:waypoint x="1600" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Serve_Bill" bpmnElement="Flow_Serve_Bill"><di:waypoint x="1660" y="380"/><di:waypoint x="1685" y="380"/><di:waypoint x="1685" y="180"/><di:waypoint x="1710" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Bill_Present" bpmnElement="Flow_Bill_Present"><di:waypoint x="1770" y="220"/><di:waypoint x="1770" y="980"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Present_Pay" bpmnElement="Flow_Present_Pay"><di:waypoint x="1890" y="980"/><di:waypoint x="1940" y="980"/><di:waypoint x="1940" y="820"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Pay_Gw" bpmnElement="Flow_Pay_Gateway"><di:waypoint x="2000" y="780"/><di:waypoint x="2075" y="780"/><di:waypoint x="2075" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_PaymentCaptured" bpmnElement="Flow_PaymentCaptured"><di:waypoint x="2100" y="180"/><di:waypoint x="2170" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_PaymentDeclined" bpmnElement="Flow_PaymentDeclined"><di:waypoint x="2050" y="180"/><di:waypoint x="2025" y="180"/><di:waypoint x="2025" y="380"/><di:waypoint x="2000" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Resolve_Pay" bpmnElement="Flow_Resolve_Pay"><di:waypoint x="1940" y="420"/><di:waypoint x="1940" y="740"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
