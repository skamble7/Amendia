{
  "descriptor_version": "1.0",
  "capability_id": "cap.dmn.repair_decision",
  "version": "1.0.0",
  "title": "Repair decision (native DMN table)",
  "description": "Maps the investigation dossier (gpi status + settlement amount) to a repair verdict via an auditable DMN decision table \u2014 no code (ADR-037).",
  "kind": "decision",
  "side_effect": "read_only",
  "idempotent": true,
  "inputs": [
    {
      "name": "dossier",
      "schema": "art.payment.enrich_investigation_output@^1.0.0"
    }
  ],
  "outputs": [
    {
      "name": "decision",
      "schema": "art.dmn.repair_decision@^1.0.0"
    }
  ],
  "runtime": {
    "kind": "decision",
    "table": {
      "hit_policy": "FIRST",
      "inputs": [
        {
          "expression": "dossier.payment.settlement_amount.value",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "verdict",
          "type": "string"
        }
      ],
      "rules": [
        {
          "when": [
            ">= 1000000"
          ],
          "then": [
            "manual_review"
          ]
        },
        {
          "when": [
            "< 1000000"
          ],
          "then": [
            "auto_repair"
          ]
        },
        {
          "when": [
            "-"
          ],
          "then": [
            "manual_review"
          ]
        }
      ]
    }
  },
  "constraints": {
    "timeout_seconds": 30,
    "max_retries": 0,
    "min_hitl_mode": "none"
  },
  "owner": "platform",
  "status": "active"
}
