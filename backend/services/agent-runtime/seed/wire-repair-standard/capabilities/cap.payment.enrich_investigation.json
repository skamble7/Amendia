{
  "descriptor_version": "1.0",
  "capability_id": "cap.payment.enrich_investigation",
  "version": "1.0.0",
  "title": "Enrich & investigate payment",
  "description": "Pulls the payment record, gpi/tracker status, account history and attachment summaries into an investigation dossier.",
  "kind": "mcp",
  "side_effect": "read_only",
  "idempotent": true,
  "inputs": [
    {
      "name": "trigger",
      "schema": "art.payment.wire_exception@^1.0.0"
    }
  ],
  "outputs": [
    {
      "name": "dossier",
      "schema": "art.payment.enrich_investigation_output@^1.0.0"
    }
  ],
  "runtime": {
    "kind": "mcp",
    "endpoint": "http://stub-mcp:8056/mcp",
    "tools": [
      "enrich_investigation"
    ],
    "transport": "streamable_http",
    "headers": {}
  },
  "constraints": {
    "timeout_seconds": 120,
    "max_retries": 2,
    "min_hitl_mode": "none"
  },
  "owner": "platform",
  "status": "active"
}
