{
  "artifact_key": "art.widgetqa.inspection",
  "version": "1.0.0",
  "title": "Widget inspection result",
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://amendia.dev/schemas/artifacts/widgetqa/inspection/1.0.0.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["grade", "defect_count"],
    "properties": {
      "grade": { "enum": ["pass", "fail"] },
      "defect_count": { "type": "integer", "minimum": 0 },
      "notes": { "type": "string" }
    }
  },
  "compatibility": "backward",
  "status": "active"
}
