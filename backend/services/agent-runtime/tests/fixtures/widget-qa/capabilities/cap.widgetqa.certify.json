{
  "descriptor_version": "1.0",
  "capability_id": "cap.widgetqa.certify",
  "version": "1.0.0",
  "title": "Certify widget",
  "description": "Issues a QA certificate for a widget that passed inspection via an MCP certification server.",
  "kind": "mcp",
  "side_effect": "read_only",
  "idempotent": true,
  "inputs": [
    { "name": "inspection", "schema": "art.widgetqa.inspection@^1.0.0" }
  ],
  "outputs": [
    { "name": "certificate", "schema": "art.widgetqa.certificate@^1.0.0" }
  ],
  "runtime": {
    "kind": "mcp",
    "endpoint": "http://stub-mcp:8056/mcp",
    "tools": ["certify_widget"],
    "transport": "streamable_http",
    "headers": {}
  },
  "constraints": { "timeout_seconds": 30, "max_retries": 1, "min_hitl_mode": "none" },
  "owner": "platform",
  "status": "active"
}
