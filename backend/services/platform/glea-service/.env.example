# glea-service (ADR-058 Phase B) — env template. All keys are GLEA_-prefixed.
GLEA_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
GLEA_AUDIT_QUEUE=glea.audit_events

GLEA_CLICKHOUSE_HOST=clickhouse
GLEA_CLICKHOUSE_PORT=8123
GLEA_CLICKHOUSE_DB=glea
GLEA_CLICKHOUSE_USER=default
GLEA_CLICKHOUSE_PASSWORD=
GLEA_CLICKHOUSE_TABLE=audit_events
# Append-only audit horizon (days), independent of the operational-trace TTL. ~7 years default.
GLEA_AUDIT_TTL_DAYS=2555

GLEA_PORT=8090
GLEA_LOG_LEVEL=INFO

# OTel bootstrap (ADR-058) — Collector endpoint; unset ⇒ telemetry disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
